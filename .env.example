# Salin file ini menjadi .env, lalu isi sesuai server kamu.
# Jangan upload .env ke publik/repository.

# App
APP_BASE_URL=http://localhost/solar
ALLOW_ADMIN_SETUP=false

# Database lokal XAMPP
DB_HOST=localhost
DB_NAME=ut_fuel_monitoring
DB_USER=root
DB_PASS=

# Google Spreadsheet Web App
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/ISI_URL_DEPLOY_KAMU/exec
GOOGLE_SHEET_SECRET=ganti-dengan-token-random-panjang

# SMTP Gmail
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=emailpengirim@gmail.com
SMTP_PASSWORD=isi_app_password_gmail
SMTP_FROM_EMAIL=emailpengirim@gmail.com
SMTP_FROM_NAME=Fuel Monitoring

# Kosongkan agar tujuan email mengikuti email admin di menu Pengaturan.
ADMIN_EMAIL=

